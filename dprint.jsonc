{
	"indentWidth": 4,
	"lineWidth": 120,
	"newLineKind": "lf",
	"useTabs": true,

	"markdown": {},
	"biome": {},
	"oxc": {},
	"yaml": {},
	"excludes": [
		"test/integration/cases",
		"index.js",
		"parser.js",
		"internal/**/*.js",
		"types",
		"**/*.js.map",
		"**/node_modules",
		"**/package-lock.json"
	],
	"plugins": ["npm:@dprint/markdown", "npm:@dprint/oxc", "npm:@dprint/biome", "npm:dprint-plugin-yaml"]
}
