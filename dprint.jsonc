{
	"useTabs": true,
	"indentWidth": 4,
	"lineWidth": 120,
	"newLineKind": "lf",

	"markdown": {},
	"biome": {},
	"yaml": {},
	"excludes": [
		"benchmark/package-lock.json",
		"test/integration/cases",
		"npm/syntaxase/binding.js",
		"npm/syntaxase/package.json",
		"npm/syntaxase/@syntaxase",
		"npm/syntaxase-wasm/package.json",
		"npm/syntaxase-wasm/wasm.js"
	],
	"plugins": ["npm:@dprint/markdown", "npm:@dprint/biome", "npm:dprint-plugin-yaml"]
}
